{
  "name": "@revolutionarygamesco/pb-ship-generator",
  "description": "A module for Foundry VTT and Pirate Borg for generating random ships and their captains.",
  "version": "1.1.1",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json && vite build && npm run pack",
    "pack": "node ./scripts/pack.js",
    "complete-table": "node ./scripts/complete-table.js",
    "test": "vitest run --typecheck && npm run typecheck",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc -p tsconfig.json",
    "typecheck:build": "tsc -p tsconfig.build.json"
  },
  "devDependencies": {
    "@foundryvtt/foundryvtt-cli": "^3.0.2",
    "@types/node": "^24.5.2",
    "@vitest/coverage-v8": "^4.1.10",
    "sass": "^1.93.0",
    "typescript": "~5.8.3",
    "vite": "^7.1.6",
    "vite-plugin-static-copy": "^3.1.4",
    "vitest": "^4.1.10",
    "yaml": "^2.8.2"
  },
  "dependencies": {
    "@revolutionarygamesco/common": "^1.2.6",
    "@revolutionarygamesco/common-foundryvtt": "^0.3.6",
    "slugify": "^1.6.9"
  },
  "allowScripts": {
    "@parcel/watcher@2.6.0": true,
    "classic-level@3.0.0": true,
    "esbuild@0.28.1": true,
    "fsevents@2.3.3": true
  }
}
